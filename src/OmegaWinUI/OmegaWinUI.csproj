<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>OmegaWinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- x64 / ARM64 only — never AnyCPU (design §2.1, win-dev-skills rule). -->
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Native AOT: persistent project intent from the first commit
         (design §3.1, win-dev-skills sourcegen-patterns). PublishAot=true
         also turns trim/AOT analysis ON during development builds, so
         violations surface in the inner loop, not at release.
         IRON RULE: fix IL/CsWinRT warnings — never suppress them. -->
    <PublishAot>true</PublishAot>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <!-- CsWinRTAotOptimizerEnabled defaults to True (Auto) — do not turn it off. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions live in Directory.Packages.props (central management). -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <!-- Per-app WinUI analyzer (win-dev-skills winui-dev-workflow):
         the CLI does not inject it; keep PrivateAssets="all". -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmegaWinUI.Core\OmegaWinUI.Core.csproj" />
  </ItemGroup>

</Project>
