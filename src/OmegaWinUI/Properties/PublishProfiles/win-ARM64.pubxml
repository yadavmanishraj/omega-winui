<?xml version="1.0" encoding="utf-8"?>
<!--
  Native AOT release publish profile (ARM64), per design §3.6.
    dotnet publish src\OmegaWinUI\OmegaWinUI.csproj -c Release -p:PublishProfile=win-ARM64
  Requires the MSVC "Desktop development with C++" workload incl. ARM64 tools.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <Platform>ARM64</Platform>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
</Project>
