<?xml version="1.0" encoding="utf-8"?>
<!--
  Native AOT release publish profile (x64), per design §3.6.
  The project's PublishAot=true (csproj) is the persistent intent; this
  profile carries it into folder publishes:
    dotnet publish src\OmegaWinUI\OmegaWinUI.csproj -c Release -p:PublishProfile=win-x64
  AOT validation means running the PUBLISHED artifact
  (winapp run with the aot flag) — a JIT run proves nothing.
  Requires the MSVC "Desktop development with C++" workload.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platform>x64</Platform>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
</Project>
