<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <!-- Packaged execution model (design §4): this manifest is never deleted.
       Publisher must match the signing certificate subject. -->
  <Identity
    Name="YadavManishRaj.OmegaWinUI"
    Publisher="CN=ManishRajYadav"
    Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="d046d67c-0336-4666-acce-b3c07b0c3966" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Omega</DisplayName>
    <PublisherDisplayName>Manish Raj Yadav</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Omega"
        Description="Omega — a no-login JioSaavn music client for Windows"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <!-- Least privilege (design §4): internet access only. -->
  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>

</Package>
